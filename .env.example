# Copy to .env and fill in before running in production.

# Port the server listens on.
PORT=3000

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deployed behind HTTPS (enables secure cookies).
NODE_ENV=development

# Credentials for the initial admin account, seeded automatically the first
# time the server starts with an empty database. Change the password after
# first login (or create your own admin from this account and remove it).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
