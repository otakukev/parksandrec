# Copy to .env and fill in before running in production.

# Port the server listens on for local dev (node server.js). Netlify Functions
# don't use this — Netlify invokes the function directly.
PORT=3000

# Postgres connection string. For local dev, point this at a local Postgres
# database. In production, use your Netlify DB (Neon) connection string, or
# any other hosted Postgres (Supabase, Neon, RDS, etc).
DATABASE_URL=postgresql://parksandrec:parksandrec@localhost:5432/parksandrec

# Set to "false" only for a local Postgres that doesn't support SSL. Leave
# unset/true for hosted Postgres (Neon, Supabase, etc.), which require it.
DATABASE_SSL=false

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deployed behind HTTPS (enables secure cookies).
NODE_ENV=development

# Credentials for the initial admin account. Used only by "npm run migrate",
# which seeds this account if the users table is empty. Change the password
# after first login (or create your own admin from this account and remove
# it from Manage Users).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
