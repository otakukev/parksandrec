# Copy to .env and fill in before running in production.

# Port the server listens on. Hosts like Railway set this for you.
PORT=3000

# Where SQLite files (users/messages/board posts/sessions) are stored.
# Point this at a mounted persistent volume in production (e.g. /data on
# Railway) — otherwise data is lost on every redeploy/restart.
DATA_DIR=./data

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deployed behind HTTPS (enables secure cookies).
NODE_ENV=development

# Credentials for the initial admin account, seeded automatically the first
# time the server starts with an empty database. Change the password after
# first login (or create your own admin from this account and remove it).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
